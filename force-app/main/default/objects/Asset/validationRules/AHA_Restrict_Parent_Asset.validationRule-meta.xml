<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AHA_Restrict_Parent_Asset</fullName>
    <active>true</active>
    <errorConditionFormula>LocationId &lt;&gt; null &amp;&amp; ParentId &lt;&gt; null</errorConditionFormula>
    <errorDisplayField>ParentId</errorDisplayField>
    <errorMessage>An Asset cannot be both a Child (linked to a Parent Asset) and a Twin (linked to a Location) at the same time.</errorMessage>
</ValidationRule>
